# ANMOL STORE - Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set to 'memory' to use embedded zero-dependency MongoDB in-memory server,
# or supply your local/Atlas URI e.g. mongodb://127.0.0.1:27017/anmol_store
MONGODB_URI=memory

# JWT Secrets
JWT_ACCESS_SECRET=anmol_secure_access_token_secret_key_2026_xyz
JWT_REFRESH_SECRET=anmol_secure_refresh_token_secret_key_2026_abc
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# First Admin Setup (Used by create-admin.js seed script)
INITIAL_ADMIN_NAME=Admin Anmol
INITIAL_ADMIN_EMAIL=admin@anmolstore.in
INITIAL_ADMIN_PASSWORD=Admin@Anmol2026
INITIAL_ADMIN_PHONE=9876543210

# Razorpay Configuration (Optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
