# ========================================================
# ANMOL STORE — Environment Configuration Template
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI or Atlas cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/anmol_store?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=30d
JWT_REFRESH_EXPIRY=90d

# Initial Administrator Seed Credentials
INITIAL_ADMIN_NAME=Admin Anmol
INITIAL_ADMIN_EMAIL=admin@anmolstore.in
INITIAL_ADMIN_PASSWORD=Admin@Anmol2026
INITIAL_ADMIN_PHONE=9876543210

# ========================================================
# SMS OTP Service Configuration
# Provider options: 'console' (default for dev/test), '2factor', 'msg91', 'fast2sms', 'twilio'
# ========================================================
SMS_PROVIDER=console

# Provider 1: 2Factor.in (Recommended for Indian DLT & OTP)
TWOFACTOR_API_KEY=
TWOFACTOR_AUTHSMS_TEMPLATE=

# Provider 2: MSG91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=ANMOLS

# Provider 3: Fast2SMS (Quick Indian SMS)
FAST2SMS_API_KEY=

# Provider 4: Twilio (Global SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Checkout OTP Policy ('optional', 'cod_only', or 'required')
CHECKOUT_OTP_POLICY=cod_only
